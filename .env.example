# 복사해서 .env 로 만든 뒤 값을 채운다. (.env 는 Git 에 올라가지 않는다)

# --- DB (docker-compose 와 backend 공용) ---
DB_NAME=reviewsales
DB_USERNAME=app
DB_PASSWORD=app
DB_URL=jdbc:postgresql://localhost:5432/reviewsales

# --- JWT (HS256, 32바이트 이상 임의 문자열) ---
# 예: openssl rand -base64 48
# local 프로필에서 비워 두면 기동 시 임시 키를 생성한다(재시작하면 기존 토큰 무효).
JWT_SECRET=

# --- 작성자 닉네임 해시용 salt (backend 와 collector 가 같은 값을 써야 dedup 이 맞는다) ---
AUTHOR_HASH_SALT=

# --- collector 주소 ---
COLLECTOR_BASE_URL=http://localhost:8000

# --- OAuth (없으면 해당 로그인만 비활성화) ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth Redirect URI 의 앞부분 (콜백: {OAUTH_REDIRECT_BASE}/api/v1/auth/oauth/{provider}/callback)
OAUTH_REDIRECT_BASE=http://localhost:8080
# 로그인 성공 후 이동할 프론트 주소 ({FRONTEND_BASE_URL}/login/success). 기본값은 backend 에 내장된 프로토타입 웹
FRONTEND_BASE_URL=http://localhost:8080

# --- 수집 ---
# 같은 매장 재수집 제한 (기본 1h)
COLLECT_MIN_INTERVAL=1h
# 주간 자동 수집 (매주 월 04:00, 기본 false)
COLLECT_WEEKLY_ENABLED=false
# collector: 설정하면 네이버 대신 가상 fixture 로 동작 (오프라인 리허설용)
# COLLECTOR_FIXTURE_DIR=fixtures_demo

# --- 쿠키 (HTTPS 배포 시 true) ---
COOKIE_SECURE=false
